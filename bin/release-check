#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_ROOT="$(mktemp -d -t tokenmaxx-release-check-XXXXXX)"
TMP_CONFIG="${TMP_ROOT}/config.json"
WITH_LIVE=0
LIVE_CONFIG="${HOME}/.config/tokenmaxx/config.json"

cleanup() {
  rm -rf "$TMP_ROOT"
}

usage() {
  cat <<'EOF'
Usage: bin/release-check [--with-live] [--live-config PATH]

  --with-live         Run live provider checks against a real config.
  --live-config PATH  Config to use for live checks. Defaults to ~/.config/tokenmaxx/config.json.
EOF
}

run_step() {
  echo
  echo "==> $1"
  shift
  "$@"
}

run_quiet_step() {
  echo
  echo "==> $1"
  shift
  "$@" >/dev/null
}

validate_provider_json() {
  local provider="$1"
  ruby -rjson -e '
    payload = JSON.parse(STDIN.read)
    item = payload.first || {}
    error = item["error"].to_s.strip
    usage = item["usage"]
    abort("provider #{ARGV[0]} returned no usage payload") if usage.nil?
    abort("provider #{ARGV[0]} returned error: #{error}") unless error.empty?
  ' "$provider"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --with-live)
      WITH_LIVE=1
      shift
      ;;
    --live-config)
      [[ $# -ge 2 ]] || {
        usage
        exit 1
      }
      LIVE_CONFIG="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

trap cleanup EXIT

cd "$ROOT_DIR"

run_step "pre-commit" python3 -m pre_commit run --all-files
run_step "bash syntax" bash -n bin/release-check
run_step "ruby syntax" bash -lc 'for path in bin/tokenmaxx $(rg --files lib test -g "*.rb"); do ruby -wc "$path" || exit $?; done'
run_step "test suite" ruby -Itest test/run.rb
run_quiet_step "config init" env HOME="$TMP_ROOT" bin/tokenmaxx config init --config "$TMP_CONFIG"
run_step "config validate" env HOME="$TMP_ROOT" bin/tokenmaxx config validate --config "$TMP_CONFIG"
run_quiet_step "config dump" env HOME="$TMP_ROOT" bin/tokenmaxx config dump --config "$TMP_CONFIG" --format json
run_quiet_step "waybar render" env HOME="$TMP_ROOT" bin/tokenmaxx waybar render --config "$TMP_CONFIG"
run_quiet_step "ui status" env HOME="$TMP_ROOT" bin/tokenmaxx ui status --config "$TMP_CONFIG" --format json --pretty
run_quiet_step "cached status" env HOME="$TMP_ROOT" bin/tokenmaxx status --cached --config "$TMP_CONFIG" --format json
run_quiet_step "cached cost" env HOME="$TMP_ROOT" bin/tokenmaxx cost --cached --config "$TMP_CONFIG" --format json
run_quiet_step "history" env HOME="$TMP_ROOT" bin/tokenmaxx history --config "$TMP_CONFIG" --format json
run_quiet_step "cache clear" env HOME="$TMP_ROOT" bin/tokenmaxx cache clear all --config "$TMP_CONFIG" --format json

if command -v quickshell >/dev/null 2>&1; then
  echo
  echo "==> quickshell load"
  set +e
  env \
    HOME="$TMP_ROOT" \
    QT_QPA_PLATFORM=wayland \
    TOKENMAXX_BIN="$ROOT_DIR/bin/tokenmaxx" \
    TOKENMAXX_CONFIG="$TMP_CONFIG" \
    TOKENMAXX_STATE_DIR="${TMP_ROOT}/.local/state/tokenmaxx" \
    timeout 8s quickshell --path "$ROOT_DIR/frontend/quickshell/shell.qml" >/dev/null
  status=$?
  set -e
  if [[ "$status" -ne 0 && "$status" -ne 124 ]]; then
    echo "QuickShell load failed with exit code $status" >&2
    exit "$status"
  fi
fi

if [[ "$WITH_LIVE" -eq 1 ]]; then
  [[ -f "$LIVE_CONFIG" ]] || {
    echo "Live config not found at $LIVE_CONFIG" >&2
    exit 1
  }

  run_step "live config validate" bin/tokenmaxx config validate --config "$LIVE_CONFIG"

  for provider in codex claude gemini opencode zai ollama; do
    echo
    echo "==> live provider $provider"
    bin/tokenmaxx usage --provider "$provider" --format json --pretty --config "$LIVE_CONFIG" | validate_provider_json "$provider"
    echo "$provider validated"
  done

  run_step "live service status" bin/tokenmaxx status --config "$LIVE_CONFIG" --format json --pretty
fi

echo
echo "release-check passed"
